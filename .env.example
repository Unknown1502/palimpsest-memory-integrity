# CockroachDB connection string. See database/README.md.
PALIMPSEST_DSN=postgresql://root@localhost:26257/palimpsest?sslmode=disable

# AWS region for Bedrock (Claude + Titan Text Embeddings V2).
AWS_REGION=us-east-1

# Bedrock model IDs used by agent/bedrock_client.py.
PALIMPSEST_EMBED_MODEL=amazon.titan-embed-text-v2:0
PALIMPSEST_ADJUDICATOR_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0

# Set to "false" only to run demo/attack_scenario.py's Phase 3A (proving
# the attack succeeds with the integrity filter bypassed). Never set this
# to "false" outside that controlled demo.
PALIMPSEST_GATE_ENABLED=true
