# CockroachDB connection string. See database/README.md.
PALIMPSEST_DSN=postgresql://root@localhost:26257/palimpsest?sslmode=disable

# AWS region for Bedrock (Claude + Titan Text Embeddings V2).
AWS_REGION=us-east-1

# Bedrock model IDs used by agent/bedrock_client.py.
PALIMPSEST_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Cross-region inference profile ID, not the bare model ID — newer Claude
# models on Bedrock reject on-demand invocation by bare model ID (confirmed
# empirically). Find available profiles with:
#   aws bedrock list-inference-profiles --region us-east-1
# Haiku 4.5 by default: cheaper and well-suited to this project's tasks
# (structured extraction/classification, not open-ended reasoning). Each
# third-party model has its own separate AWS Marketplace subscription —
# override this to try Sonnet/Opus once their own subscription clears.
PALIMPSEST_ADJUDICATOR_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Set to "false" only to run demo/attack_scenario.py's Phase 3A (proving
# the attack succeeds with the integrity filter bypassed). Never set this
# to "false" outside that controlled demo.
PALIMPSEST_GATE_ENABLED=true

# Which provider serves chat()/adjudicate() (see agent/llm.py). Defaults to
# "bedrock". Set to "anthropic_api" to use agent/anthropic_client.py instead
# -- a direct console.anthropic.com API key -- when Claude-via-Bedrock is
# blocked (e.g. an AWS Marketplace billing/subscription issue).
PALIMPSEST_LLM_PROVIDER=bedrock

# Which provider serves embed(). "bedrock" (default) is Titan Text
# Embeddings V2. "local" is agent/local_embeddings.py: a dependency-free,
# offline, deterministic lexical embedding that needs no AWS account and no
# API key.
#
# Set this to "local" if AWS is unavailable for any reason. It is what keeps
# demo/grand_prize.py, demo/benchmark.py and the console runnable without a
# cloud account at all -- verified end to end, all five acts passing.
#
# Understand the trade before using it in anger: the local provider scores
# LEXICAL overlap, not meaning. Shared identifiers (IPs, subject keys) match
# well; paraphrases do not. Read agent/local_embeddings.py's docstring.
PALIMPSEST_EMBED_PROVIDER=bedrock

# Required only when PALIMPSEST_LLM_PROVIDER=anthropic_api. Get a key from
# https://console.anthropic.com — set it as a real environment variable in
# your own shell, never commit an actual key to this file or any other.
ANTHROPIC_API_KEY=sk-ant-...

# When PALIMPSEST_LLM_PROVIDER=anthropic_api, this is the direct Anthropic
# API model ID (bare string, e.g. "claude-haiku-4-5" -- no "us.anthropic."
# prefix, no ":0" suffix; that naming is Bedrock-specific). Overrides
# agent/anthropic_client.py's DEFAULT_MODEL. When PALIMPSEST_LLM_PROVIDER=
# bedrock (default), this is instead the Bedrock inference profile ID -- see
# the PALIMPSEST_ADJUDICATOR_MODEL comment above.
# PALIMPSEST_ADJUDICATOR_MODEL=claude-haiku-4-5
